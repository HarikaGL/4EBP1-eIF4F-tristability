StandardForm],"Output",CellLabel -> "Out[35]= ",ExpressionUUID -> "230a3517-2d6e-4441-a510-464647c18389"]},
Open],ExpressionUUID -> "01c2e11d-b22b-4c9e-8d98-d441df846329"],Cell[
"\<Computing the rebinding constants. kb2 and kb8 have not been measured. Setting Gamma1 = Exp[19.8] and solving for their product rho1 = kb2 kb8 gives rho1 = kf1 kf2 kf7 kf8/(kb1 kb7 Gamma) (Methods 4.2, Step 5, Eq for rho).\>",
"Text",FontColor -> RGBColor[0,0,1],ExpressionUUID -> "3cd2e9fa-0507-4003-adf8-2e0e1335f2c9"],Cell[
CellGroupData[
{Cell[
"\<rhoSol = Solve[Gamma1 == gam /. kb8 -> rho/kb2, rho]
rho1 = rho /. First[rhoSol] /. gam -> Exp[19.8] /. num1\>",
"Input",CellLabel -> "In[36]:= ",ExpressionUUID -> "c49c1e66-c7d5-4889-b5bd-e8f2b8d3c7d8"],Cell[
BoxData[
RowBox[{"{",RowBox[{"{",RowBox[{"rho","\[Rule]",FractionBox[RowBox[{"kf1"," ","kf2"," ","kf7"," ","kf8"}],
RowBox[{"gam"," ","kb1"," ","kb7"}]]}],"}"}],"}"}],StandardForm],"Output",CellLabel -> "Out[36]= ",
ExpressionUUID -> "756cd158-3f5c-4ff2-afa6-1437f08a9d2f"],Cell[
BoxData["1.5711688702239752`*^-15",
StandardForm],"Output",CellLabel -> "Out[37]= ",ExpressionUUID -> "0ba3bedf-d5b6-4ed6-8b76-243d3c6d00c9"]},
Open],ExpressionUUID -> "bad90281-e934-445c-bfbb-e461ef164d47"],Cell[
"\<The split u shares rho between kinase and phosphatase: kb2 = Sqrt[rho] 10^u, kb8 = Sqrt[rho] 10^-u, so kb2 kb8 = rho for any u. With u = -0.34 this gives the reference values 1.8118*10^-8 and 8.6718*10^-8 1/(nM s).\>",
"Text",FontColor -> RGBColor[0,0,1],ExpressionUUID -> "08a7f754-86f7-45f8-9c42-566c7076bd86"],Cell[
CellGroupData[
{Cell[
"\<u = -0.34;
{kb2calc, kb8calc} = {Sqrt[rho1] 10^u, Sqrt[rho1] 10^-u}
{kb2calc kb8calc == rho1, kb2calc/kbRef[[2]], kb8calc/kbRef[[8]]}\>",
"Input",CellLabel -> "In[38]:= ",ExpressionUUID -> "1a25b0ba-5282-4a48-88c2-eae27107e6e9"],Cell[
BoxData[
RowBox[{"{",RowBox[{"1.8118049126429878`*^-8",",","8.671843526089229`*^-8"}],"}"}],
StandardForm],"Output",CellLabel -> "Out[39]= ",ExpressionUUID -> "a75452b6-624e-4f71-b192-84238ef59a40"],Cell[
BoxData[
RowBox[{"{",RowBox[{"True",",","1.`",",","1.`"}],"}"}],StandardForm],"Output",CellLabel -> "Out[40]= ",
ExpressionUUID -> "84384d26-673b-4e83-92d4-846829c23bf5"]},Open],ExpressionUUID -> "95344efe-2adc-4d48-ae22-a6cd57cd806e"],Cell[

"\<6. All four PdP cycles (Supplementary Table 5)\>","Section",ExpressionUUID -> "f336b496-022a-4991-b566-330b63a8a454"],Cell[

"\<The four cycles, each listed as {a, b, c, d} = {kinase binding, kinase catalysis, phosphatase binding, phosphatase catalysis}.\>",
"Text",FontColor -> RGBColor[0,0,1],ExpressionUUID -> "5fbda533-7952-4633-9f9d-c556a23abb18"],Cell[

"\<cycles = {{1, 2, 7, 8}, {3, 4, 5, 6}, {9, 10, 15, 16}, {11, 12, 13, 14}};\>","Input",
CellLabel -> "In[41]:= ",ExpressionUUID -> "c9533e96-a1da-4650-a78c-258db8a81002"],Cell[

"\<For each cycle: the six given constants, rho from lnGamma = 19.8, the two rebinding constants with u = -0.34, and the checks lnKkin, lnKp, lnGamma and DeltaGc recomputed from all eight constants (one column per cycle). Every cycle gives lnGamma = 19.800 and DeltaGc = 51.06 kJ/mol.\>",
"Text",FontColor -> RGBColor[0,0,1],ExpressionUUID -> "625fc11a-d19f-4f22-a6f1-6d6dc703fcbc"],Cell[

"\<row[{a_, b_, c_, d_}] := Module[{rh, kbb, kbd},
  rh = kfRef[[a]] kfRef[[b]] kfRef[[c]] kfRef[[d]]/(kbRef[[a]] kbRef[[c]]
  Exp[19.8]);
  kbb = Sqrt[rh] 10^-0.34; kbd = Sqrt[rh] 10^0.34;
  {StringJoin[\"R\", ToString[a], \",R\", ToString[b], \"|R\", ToString[c], \",R\",
  ToString[d]],
   kfRef[[a]], kbRef[[a]], kfRef[[b]], kfRef[[c]], kbRef[[c]], kfRef[[d]],
  ScientificForm[rh, 4], ScientificForm[kbb, 4], ScientificForm[kbd, 4],
   NumberForm[Log[kfRef[[a]] kfRef[[b]]/(kbRef[[a]] kbb)], {6, 3}],
  NumberForm[Log[kfRef[[c]] kfRef[[d]]/(kbRef[[c]] kbd)], {6, 3}],
   NumberForm[Log[kfRef[[a]] kfRef[[b]] kfRef[[c]] kfRef[[d]]/(kbRef[[a]] kbb
  kbRef[[c]] kbd)], {6, 3}],
   NumberForm[RT Log[kfRef[[a]] kfRef[[b]] kfRef[[c]] kfRef[[d]]/(kbRef[[a]] kbb
  kbRef[[c]] kbd)], {5, 2}]}]\>",
