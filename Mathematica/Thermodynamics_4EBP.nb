  kfRef[[c[[4]]]]/(kbRef[[c[[1]]]] kbRef[[c[[3]]]] Exp[19.8])},
  {Sqrt[rh] 10^-0.34/kbRef[[c[[2]]]], Sqrt[rh] 10^0.34/kbRef[[c[[4]]]]}], {c,
  cycles}]\>",
